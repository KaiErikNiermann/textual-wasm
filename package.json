{
  "name": "textual-wasm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "JavaScript runtime dependencies for the textual-wasm cross-runtime check.",
  "scripts": {
    "check": "poetry run textual-wasm check",
    "lint:all": "pnpm lint:css && pnpm lint:js && pnpm lint:style && pnpm lint:ts",
    "lint:css": "eslint \"src/textual_wasm/assets/**/*.css\" \"examples/**/*.css\" \"playground/src/**/*.css\" && stylelint \"src/textual_wasm/assets/**/*.css\" \"examples/**/*.css\" \"playground/src/**/*.css\"",
    "lint:js": "eslint \"playground/src/**/*.mjs\" playground/vite.config.js",
    "lint:style": "EIO_BACKEND=posix poetry run semgrep --config .semgrep/vendor/principled-css.yml --metrics=off --error --quiet src/textual_wasm/assets examples playground/src playground/index.html",
    "lint:ts": "tsc --noEmit -p examples/page-bridge"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "pyodide": "314.0.6"
  },
  "devDependencies": {
    "@eslint/css": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-sonarjs": "^4.2.1",
    "eslint-plugin-unicorn": "^76.0.0",
    "globals": "^17.12.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "selenium-webdriver": "^4.49.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-declaration-strict-value": "^1.12.1",
    "stylelint-order": "^8.1.1",
    "tailwind-csstree": "^0.4.0",
    "typescript": "^7.0.2"
  }
}
