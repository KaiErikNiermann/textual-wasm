#!/usr/bin/env bash
# Gate: lint, format, types, complexity, policy rules, tests.
#
# Deliberately does NOT run the Pyodide probe. That needs a network fetch for the wheels and
# takes several seconds, which is a CI job's business rather than a push gate's; the pytest
# suite already covers the driver natively, and `scripts/run-spike.sh` runs both halves when
# you actually want the comparison.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "${ROOT}"

step() { printf '\n==> %s\n' "$1"; }

step "author identity"
# Backstop for the pre-commit hook, which `--no-verify` skips. Attribution cannot be
# corrected once GitHub has the commit, so this is the last chance to catch it.
#
# The refs being pushed arrive on stdin as `<local ref> <local sha> <remote ref>
# <remote sha>`; reading them rather than `@{upstream}` is what makes this fire on a
# branch that has no upstream yet, which is the common case for a new topic branch.
ZERO="0000000000000000000000000000000000000000"
denied="$(git config --get-all identity.denyEmail 2>/dev/null || true)
kai.niermann@googlemail.com"

check_range() {
  local range="$1" sha who bad
  while read -r sha who; do
    while read -r bad; do
      [ -z "${bad}" ] && continue
      case "${who}" in
        *"<${bad}>"*)
          echo "error: ${sha} carries the identity ${bad}" >&2
          echo "       GitHub attributes it to the wrong account and contributor lists" >&2
          echo "       cannot be edited afterwards; rewrite the commit before pushing." >&2
          exit 1
          ;;
      esac
    done <<< "${denied}"
  done < <(git log --format='%h %an <%ae> %cn <%ce>' ${range})
}

while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "${local_sha}" = "${ZERO}" ] && continue          # branch deletion
  if [ "${remote_sha}" = "${ZERO}" ]; then
    # New branch: everything on it that no other remote ref already has.
    check_range "${local_sha} --not --remotes=origin"
  else
    check_range "${remote_sha}..${local_sha}"
  fi
done

step "ruff (lint)"
poetry run ruff check src tests

step "ruff (format)"
poetry run ruff format --check src tests

step "pyright (strict)"
poetry run pyright

step "radon (nothing above grade B)"
# `-n C` lists grade C and worse, i.e. everything *above* B, which is the threshold the
# convention sets. `-n B` would also list grade B, which is explicitly acceptable.
offenders="$(poetry run radon cc -n C src)"
if [[ -n "${offenders}" ]]; then
  echo "${offenders}"
  echo "error: blocks above grade B; simplify or split them" >&2
  exit 1
fi
poetry run radon cc -a src | tail -2

step "semgrep (conventions + core-utils)"
# EIO_BACKEND=posix: without it semgrep-core fails intermittently on this machine with
# `Unix_error: Cannot allocate memory io_uring_queue_init`, and returns an empty results
# list - a crashed scan then looks exactly like a clean one.
EIO_BACKEND=posix poetry run semgrep --config .semgrep/conventions.yml \
  --config .semgrep/core-utils.yml --metrics=off --error --quiet src

step "eslint + stylelint + principled-css"
# Added after a stylesheet in an example shipped unlayered: the JavaScript and CSS gates
# existed but were only ever run by hand, so a rule nobody invoked caught nothing.
if command -v pnpm >/dev/null 2>&1; then
  pnpm lint:all
else
  echo "pnpm not installed; skipping the JavaScript and CSS gates" >&2
fi

step "pytest"
poetry run pytest

printf '\nall gates passed\n'
